{
  "name": "axolotl-2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && node scripts/clean-build.mjs && vite build && node scripts/finalize-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:legacy": "node --test tests/*.test.cjs",
    "preview": "vite preview --host 0.0.0.0",
    "publish:prepare": "npm run build && node scripts/publish-build.mjs",
    "publish:check": "node scripts/publish-build.mjs --check",
    "test:tools": "node scripts/test-tools.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.12",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jszip": "3.10.1",
    "lucide-react": "1.53.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "@floating-ui/react": "0.27.20"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "jsqr": "1.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "@axe-core/playwright": "4.14.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
