 export function PanelHeading({ title, close, back, eyebrow }: { title: string; close: () => void; back?: () => void; eyebrow?: string }) {
+  // In preview, ordinary desktop hover menus dismiss via pointer/Escape/outside.
+  // Detailed settings and compact/touch panels retain their explicit close action.
+  const [desktopHover, setDesktopHover] = useState(() => matchMedia('(min-width: 1181px) and (hover: hover) and (pointer: fine)').matches);
+  useEffect(() => {
+    const media = matchMedia('(min-width: 1181px) and (hover: hover) and (pointer: fine)');
+    const update = () => setDesktopHover(media.matches);
+    media.addEventListener('change', update);
+    return () => media.removeEventListener('change', update);
+  }, []);
   return <div className={s.panelHeading}>
     {back && <Control label="Zpět do nastavení" icon="chevron" className={s.back} onClick={back} autoFocus/>}
     <div>{eyebrow && <span className={s.eyebrow}>{eyebrow}</span>}<h2>{title}</h2></div>
-    <Control label="Zavřít nabídku" className={s.close} onClick={close}><span aria-hidden="true">×</span></Control>
+    {(!desktopHover || back || eyebrow) && <Control label="Zavřít nabídku" className={s.close} onClick={close}><span aria-hidden="true">×</span></Control>}
   </div>;
 }
 
